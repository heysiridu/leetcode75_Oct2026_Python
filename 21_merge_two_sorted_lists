# https://leetcode.com/problems/merge-two-sorted-lists/

# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def mergeTwoLists(self, list1: ListNode | None, list2: ListNode | None) -> ListNode | None:
        # is there two or three pointers? feel like there are three p1 p2 and dum. p1 in list1 and p2 in list2, dum to record the final one
        # which one to return? 

        dum = ListNode(-1)
        p = dum
        p1 = list1
        p2 = list2

        while p1 and p2:
            if p1.val > p2.val:
                p.next = p2
                p2 = p2.next
            else:
                p.next = p1
                p1 = p1.next
            p = p.next
        
        # 如何处理长短不一致的情况：
        if p1 is not None:
            p.next = p1

        if p2 is not None:
            p.next = p2
        
        return dum.next
        
        
